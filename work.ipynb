import requests
import json

# 1. 공공데이터포털에서 발급받은 인증키 (디코딩된 키 입력)
SERVICE_KEY = "본인의_인증키를_여기에_입력하세요"

# 2. 요청 URL 기본값
url = "https://apis.data.go.kr/B552845/perDay/price"

# 3. 요청 파라미터 구성 (전달해주신 URL의 파라미터와 동일)
params = {
    'serviceKey': SERVICE_KEY,
    'pageNo': '1',
    'numOfRows': '200',
    'returnType': 'JSON',
    'cond[exmn_ymd::GTE]': '20150101',
    'cond[exmn_ymd::LTE]': '20151231',
    'cond[se_cd::EQ]': '02',          # 구분: 도매
    'cond[ctgry_cd::EQ]': '200',     # 부류: 식량작물/채소류
    'cond[item_cd::EQ]': '211',      # 품목: 배추
    'cond[grd_cd::EQ]': '04',        # 등급: 상
    'cond[sgg_cd::EQ]': '1101',      # 시군구: 서울
    'cond[mrkt_cd::EQ]': '0110211',  # 시장: 가락도매시장
    'cond[vrty_cd::EQ]': '01'        # 품종: 봄배추
}

# 4. API 호출
response = requests.get(url, params=params, verify=False)

if response.status_code == 200:
    data = response.json()
    
    # 응답 항목 추출
    items = data.get('response', {}).get('body', {}).get('items', {}).get('item', [])
    
    if isinstance(items, dict):
        items = [items]
        
    print(f"==========================================")
    print(f"호출 결과 데이터 건수: {len(items)}건")
    print(f"==========================================")
    
    # 66건 여부 확인
    if len(items) == 66:
        print(" [검증 성공] 정확히 66건의 데이터가 조회되었습니다.")
    else:
        print(f" [주의] {len(items)}건이 조회되었습니다. 인증키 상태나 파라미터를 다시 확인해보세요.")
else:
    print(f"API 호출 실패 - HTTP 상태 코드: {response.status_code}")